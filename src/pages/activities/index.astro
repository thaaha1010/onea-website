---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allActivities = await getCollection('activities');
const activities = [...allActivities].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
const upcoming = activities.filter(a => a.data.status === 'upcoming');
const completed = activities.filter(a => a.data.status === 'completed');

const cardPalette = [
  { bg: '#1a4a2e', text: '#fff', sub: 'rgba(255,255,255,0.65)' },
  { bg: '#3a1f0d', text: '#fff', sub: 'rgba(255,255,255,0.65)' },
  { bg: '#5c3d2e', text: '#fff', sub: 'rgba(255,255,255,0.65)' },
];
---

<BaseLayout title="Activities" description="Explore ONEA's activities — upcoming events, environmental initiatives, and completed programs across the Maldives.">

  <section class="relative h-52 sm:h-64 flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0" style="background: linear-gradient(145deg, #0d2818, #1a4a2e, #3a1f0d);"></div>
    <div class="absolute inset-0 bg-black/30"></div>
    <div class="relative z-10 text-center px-4">
      <h1 class="text-3xl sm:text-5xl font-extrabold" style="color:#f5ede0;">Activities</h1>
      <p class="mt-3 text-sm sm:text-base" style="color:rgba(196,168,120,0.85);">Events, programs, and initiatives making a real impact</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20" style="background-color:#f5ede0;">

    {upcoming.length > 0 && (
      <div class="mb-16">
        <div class="flex items-center gap-3 mb-8">
          <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color:#c4a878;"></span>
          <h2 class="text-2xl font-extrabold" style="color:#0d2818;">Upcoming Activities</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {upcoming.map((activity, i) => {
            const slug = activity.id.replace(/\.md$/, '');
            const c = cardPalette[i % cardPalette.length];
            return (
              <a href={`/activities/${slug}`}
                class={`reveal reveal-delay-${(i % 3) + 1} group rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl block`}
                style={`background-color:${c.bg};`}>
                {activity.data.coverImage ? (
                  <div class="aspect-video overflow-hidden">
                    <img src={activity.data.coverImage} alt={activity.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  </div>
                ) : (
                  <div class="aspect-video flex items-center justify-center" style="background-color:rgba(0,0,0,0.15);">
                    <svg class="w-12 h-12" style={`color:${c.sub};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                    </svg>
                  </div>
                )}
                <div class="p-6">
                  <div class="flex items-center justify-between mb-3">
                    <p class="text-xs" style={`color:${c.sub};`}>{activity.data.date}{activity.data.location && ` · ${activity.data.location}`}</p>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold" style="background-color:rgba(196,168,120,0.25); color:#c4a878;">Upcoming</span>
                  </div>
                  <h3 class="text-base font-bold leading-snug mb-2" style={`color:${c.text};`}>{activity.data.title}</h3>
                  {activity.data.description && <p class="text-sm line-clamp-2 leading-relaxed" style={`color:${c.sub};`}>{activity.data.description}</p>}
                  <div class="flex items-center gap-1 mt-4 text-xs font-semibold" style="color:#c4a878;">
                    Learn more <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

    {completed.length > 0 && (
      <div>
        <div class="flex items-center gap-3 mb-8">
          <span class="w-3 h-3 rounded-full flex-shrink-0" style="background-color:#1a4a2e;"></span>
          <h2 class="text-2xl font-extrabold" style="color:#0d2818;">Past Activities</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {completed.map((activity, i) => {
            const slug = activity.id.replace(/\.md$/, '');
            const c = cardPalette[i % cardPalette.length];
            return (
              <a href={`/activities/${slug}`}
                class={`reveal reveal-delay-${(i % 3) + 1} group rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl block`}
                style={`background-color:${c.bg};`}>
                {activity.data.coverImage ? (
                  <div class="aspect-video overflow-hidden">
                    <img src={activity.data.coverImage} alt={activity.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  </div>
                ) : (
                  <div class="aspect-video flex items-center justify-center" style="background-color:rgba(0,0,0,0.15);">
                    <svg class="w-12 h-12" style={`color:${c.sub};`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  </div>
                )}
                <div class="p-6">
                  <div class="flex items-center justify-between mb-3">
                    <p class="text-xs" style={`color:${c.sub};`}>{activity.data.date}{activity.data.location && ` · ${activity.data.location}`}</p>
                    <span class="px-2.5 py-1 rounded-full text-xs font-bold" style="background-color:rgba(196,168,120,0.25); color:#c4a878;">Completed</span>
                  </div>
                  <h3 class="text-base font-bold leading-snug mb-2" style={`color:${c.text};`}>{activity.data.title}</h3>
                  {activity.data.description && <p class="text-sm line-clamp-2 leading-relaxed" style={`color:${c.sub};`}>{activity.data.description}</p>}
                  <div class="flex items-center gap-1 mt-4 text-xs font-semibold" style="color:#c4a878;">
                    Read more <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

    {activities.length === 0 && (
      <div class="text-center py-24">
        <p class="text-lg" style="color:#a89880;">No activities yet. Check back soon!</p>
      </div>
    )}
  </div>
</BaseLayout>
