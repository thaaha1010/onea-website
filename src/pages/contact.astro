---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteSettings from '../content/settings/site.json';

const whatsappUrl = siteSettings.whatsapp
  ? `https://wa.me/${siteSettings.whatsapp.replace(/[^0-9]/g, '')}`
  : null;

const socials = [
  { label: 'Instagram', url: siteSettings.instagram },
  { label: 'Facebook', url: siteSettings.facebook },
  { label: 'TikTok', url: siteSettings.tiktok },
  { label: 'YouTube', url: siteSettings.youtube },
  { label: 'Twitter / X', url: siteSettings.twitter },
].filter(s => s.url);
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with ONEA — reach us via WhatsApp, email, or through our contact form."
>

  <!-- HERO -->
  <section class="relative h-52 sm:h-64 flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0" style="background: linear-gradient(135deg, #1b4332, #40916c, #1565C0);"></div>
    <div class="absolute inset-0 bg-black/30"></div>
    <div class="relative z-10 text-center text-white px-4">
      <h1 class="text-3xl sm:text-5xl font-extrabold">Contact Us</h1>
      <p class="mt-3 text-white/80 text-sm sm:text-base">We'd love to hear from you</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">

      <!-- LEFT: Info -->
      <div class="lg:col-span-2 space-y-8">

        <div class="reveal">
          <h2 class="text-2xl font-extrabold text-brand-charcoal mb-6">Get in Touch</h2>

          <!-- WhatsApp CTA -->
          {whatsappUrl && (
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-5 rounded-2xl text-white font-semibold hover:scale-[1.02] transition-transform duration-200 shadow-lg mb-6"
              style="background-color:#25D366;"
            >
              <div class="w-12 h-12 rounded-full bg-white/20 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div>
                <p class="text-white/80 text-xs">Fastest response</p>
                <p class="text-lg">Chat on WhatsApp</p>
              </div>
            </a>
          )}

          <!-- Contact details -->
          <div class="space-y-4">
            {siteSettings.email && (
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-400 font-medium">Email</p>
                  <a href={`mailto:${siteSettings.email}`} class="text-brand-charcoal hover:text-brand-green transition-colors font-medium text-sm">
                    {siteSettings.email}
                  </a>
                </div>
              </div>
            )}

            {siteSettings.phone && (
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-400 font-medium">Phone</p>
                  <a href={`tel:${siteSettings.phone}`} class="text-brand-charcoal hover:text-brand-green transition-colors font-medium text-sm">
                    {siteSettings.phone}
                  </a>
                </div>
              </div>
            )}

            {siteSettings.address && (
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-brand-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-400 font-medium">Address</p>
                  <p class="text-brand-charcoal font-medium text-sm">{siteSettings.address}</p>
                </div>
              </div>
            )}
          </div>

          <!-- Social links -->
          {socials.length > 0 && (
            <div class="mt-8 pt-6 border-t border-gray-100">
              <p class="text-xs text-gray-400 font-semibold uppercase tracking-wider mb-4">Follow Us</p>
              <div class="flex gap-3 flex-wrap">
                {socials.map(s => (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-4 py-2 rounded-full text-sm font-medium border border-gray-200 text-gray-600 hover:border-brand-green hover:text-brand-green transition-colors duration-200"
                  >
                    {s.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Google Maps embed -->
        {siteSettings.mapsEmbed && (
          <div class="reveal reveal-delay-1 rounded-2xl overflow-hidden shadow-sm border border-gray-100">
            <iframe
              src={siteSettings.mapsEmbed}
              width="100%"
              height="250"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="ONEA location on Google Maps"
            ></iframe>
          </div>
        )}
      </div>

      <!-- RIGHT: Contact form -->
      <div class="lg:col-span-3 reveal reveal-delay-1">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 sm:p-10">
          <h2 class="text-2xl font-extrabold text-brand-charcoal mb-2">Send Us a Message</h2>
          <p class="text-gray-500 text-sm mb-8">
            Fill in the form below and we'll get back to you as soon as possible.
          </p>

          <!--
            To activate this form, sign up at https://formspree.io/,
            create a form, and replace XXXXXXXX with your Formspree form ID.
          -->
          <form
            method="POST"
            action="https://formspree.io/f/XXXXXXXX"
            id="contact-form"
            class="space-y-5"
            novalidate
          >
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-semibold text-brand-charcoal mb-1.5">
                  Full Name <span class="text-red-400">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Your name"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-brand-charcoal text-sm focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white"
                  style="focus:ring-color:#4CAF50;"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-semibold text-brand-charcoal mb-1.5">
                  Email Address <span class="text-red-400">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="your@email.com"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-brand-charcoal text-sm focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white"
                />
              </div>
            </div>

            <div>
              <label for="phone" class="block text-sm font-semibold text-brand-charcoal mb-1.5">
                Phone Number
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+960 xxx xxxx"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-brand-charcoal text-sm focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-semibold text-brand-charcoal mb-1.5">
                Subject
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                placeholder="What is this about?"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-brand-charcoal text-sm focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-brand-charcoal mb-1.5">
                Message <span class="text-red-400">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                placeholder="Tell us how we can help..."
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-brand-charcoal text-sm focus:outline-none focus:ring-2 focus:border-transparent transition-all duration-200 bg-gray-50 focus:bg-white resize-none"
              ></textarea>
            </div>

            <div id="form-success" class="hidden p-4 rounded-xl text-sm font-medium" style="background-color:#e8f5e9;color:#2e7d32;">
              Thank you! Your message has been sent. We'll be in touch soon.
            </div>

            <div id="form-error" class="hidden p-4 rounded-xl text-sm font-medium bg-red-50 text-red-700">
              Oops! Something went wrong. Please try again or contact us directly via WhatsApp.
            </div>

            <button
              type="submit"
              class="w-full text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 hover:scale-[1.02] hover:shadow-lg active:scale-[0.98] text-sm"
              style="background-color:#4CAF50;"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('form-success');
  const errorMsg = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const action = form.action;
    if (action.includes('XXXXXXXX')) {
      errorMsg?.classList.remove('hidden');
      successMsg?.classList.add('hidden');
      return;
    }

    const data = new FormData(form);
    try {
      const res = await fetch(action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        successMsg?.classList.remove('hidden');
        errorMsg?.classList.add('hidden');
        form.reset();
      } else {
        throw new Error('Non-OK response');
      }
    } catch {
      errorMsg?.classList.remove('hidden');
      successMsg?.classList.add('hidden');
    }
  });
</script>
