---
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutContent from '../content/pages/about.json';

function initials(name: string) {
  return name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
}
const avatarBgs = ['#1a4a2e','#3a1f0d','#5c3d2e','#2d6a4f','#6b4220','#1e4d2b'];
---

<BaseLayout title="About Us" description="Learn about ONEA's mission, vision, story, and team driving change across the Maldives.">

  <!-- HERO -->
  <section class="relative h-64 sm:h-80 flex items-center justify-center overflow-hidden">
    {aboutContent.heroImage
      ? <img src={aboutContent.heroImage} alt="About ONEA" class="absolute inset-0 w-full h-full object-cover" />
      : <div class="absolute inset-0" style="background: linear-gradient(145deg, #0d2818 0%, #1a4a2e 50%, #3a1f0d 100%);"></div>
    }
    <div class="absolute inset-0 bg-black/45"></div>
    <div class="relative z-10 text-center px-4">
      <h1 class="text-3xl sm:text-5xl font-extrabold" style="color:#f5ede0;">About Us</h1>
      <p class="mt-3 text-sm sm:text-base" style="color:rgba(196,168,120,0.85);">Who we are · What we believe · Why it matters</p>
    </div>
  </section>

  <!-- MISSION & VISION -->
  <section class="py-20" style="background-color:#f5ede0;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="reveal rounded-2xl p-8" style="background-color:#1a4a2e;">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5" style="background-color:rgba(196,168,120,0.2);">
            <svg class="w-6 h-6" style="color:#c4a878;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
            </svg>
          </div>
          <h2 class="text-2xl font-extrabold mb-4" style="color:#f5ede0;">Our Mission</h2>
          <p class="leading-relaxed" style="color:rgba(232,213,176,0.8);">{aboutContent.mission}</p>
        </div>
        <div class="reveal reveal-delay-1 rounded-2xl p-8" style="background-color:#3a1f0d;">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5" style="background-color:rgba(196,168,120,0.2);">
            <svg class="w-6 h-6" style="color:#c4a878;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h2 class="text-2xl font-extrabold mb-4" style="color:#f5ede0;">Our Vision</h2>
          <p class="leading-relaxed" style="color:rgba(232,213,176,0.8);">{aboutContent.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR STORY -->
  <section class="py-20 sm:py-24" style="background-color:#ece0cc;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="reveal">
          <span class="inline-block text-xs font-bold uppercase tracking-widest mb-4 px-3 py-1 rounded-full" style="background-color:#e0d0b8; color:#5c3d2e;">Our Story</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold mt-3 mb-6 leading-tight" style="color:#0d2818;">How It All Started</h2>
          <div class="prose-onea">
            {aboutContent.story.split('\n\n').map(para => <p>{para}</p>)}
          </div>
        </div>
        <div class="reveal reveal-delay-1">
          {aboutContent.storyImage ? (
            <img src={aboutContent.storyImage} alt="Our Story" class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]" />
          ) : (
            <div class="w-full rounded-2xl aspect-[4/3] flex flex-col items-center justify-center gap-3" style="background: linear-gradient(145deg, #1a4a2e, #2d6a4f);">
              <svg class="w-16 h-16" style="color:rgba(196,168,120,0.3);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5z"/>
              </svg>
              <p class="text-sm" style="color:rgba(196,168,120,0.5);">Add your story image via CMS</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  {aboutContent.team?.length > 0 && (
    <section class="py-20 sm:py-24" style="background-color:#f5ede0;">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14 reveal">
          <span class="inline-block text-xs font-bold uppercase tracking-widest mb-3 px-3 py-1 rounded-full" style="background-color:#ece0cc; color:#5c3d2e;">The People</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold mt-3" style="color:#0d2818;">Our Team</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {aboutContent.team.map((member, i) => (
            <div class={`reveal reveal-delay-${(i % 4) + 1} rounded-2xl p-6 text-center transition-shadow duration-300 hover:shadow-lg`} style="background-color:#fff;">
              <div class="w-20 h-20 rounded-full overflow-hidden mx-auto mb-4 flex items-center justify-center text-white font-extrabold text-lg shadow-md"
                style={`background-color:${avatarBgs[i % avatarBgs.length]};`}>
                {member.photo
                  ? <img src={member.photo} alt={member.name} class="w-full h-full object-cover" />
                  : initials(member.name)
                }
              </div>
              <h3 class="font-bold text-base" style="color:#1a1a1a;">{member.name}</h3>
              <p class="text-xs font-bold uppercase tracking-wider mt-0.5 mb-3" style="color:#c4a878;">{member.role}</p>
              {member.bio && <p class="text-sm leading-relaxed" style="color:#6b5a4a;">{member.bio}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-20" style="background: linear-gradient(145deg, #0d2818, #1a4a2e, #3a1f0d);">
    <div class="max-w-3xl mx-auto text-center px-4 reveal">
      <h2 class="text-3xl sm:text-4xl font-extrabold mb-4" style="color:#f5ede0;">Ready to Make a Difference?</h2>
      <p class="text-lg mb-8" style="color:rgba(232,213,176,0.8);">Join ONEA and become part of a movement shaping a greener, stronger Maldives.</p>
      <a href="/contact" class="inline-block font-bold px-8 py-4 rounded-full text-base transition-all duration-300 hover:scale-105 hover:shadow-xl" style="background-color:#c4a878; color:#1a1a1a;">
        Get in Touch
      </a>
    </div>
  </section>

</BaseLayout>
