---
import siteSettings from '../content/settings/site.json';

const year = new Date().getFullYear();

const socials = [
  { label: 'Instagram', url: siteSettings.instagram },
  { label: 'Facebook', url: siteSettings.facebook },
  { label: 'TikTok', url: siteSettings.tiktok },
  { label: 'YouTube', url: siteSettings.youtube },
  { label: 'Twitter / X', url: siteSettings.twitter },
].filter(s => s.url);
---

<footer style="background-color:#0d2818; color:#e8d5b0;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">

      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-5 w-fit">
          <div class="w-12 h-12 rounded-full overflow-hidden flex items-center justify-center" style="background-color:#1a4a2e; border:2px solid #c4a878;">
            <img src="/images/logo.png" alt="ONEA" class="w-full h-full object-cover"
              onerror="this.style.display='none';this.parentElement.innerHTML='<span style=\'color:white;font-weight:900;\'>ONEA</span>'" />
          </div>
          <div class="leading-none">
            <p class="font-extrabold text-xl tracking-tight" style="color:#e8d5b0;">ONEA</p>
            <p class="text-xs mt-0.5" style="color:#c4a878;">{siteSettings.tagline}</p>
          </div>
        </a>
        <p class="text-sm leading-relaxed max-w-xs" style="color:#a89880;">
          Empowering youth through nature, community, and shared vision across the Maldives.
        </p>
        {socials.length > 0 && (
          <div class="flex gap-3 mt-6 flex-wrap">
            {socials.map(s => (
              <a href={s.url} target="_blank" rel="noopener noreferrer"
                class="px-3 py-1.5 rounded-full text-xs font-medium border transition-colors duration-200"
                style="border-color:#c4a87860; color:#c4a878;"
                onmouseover="this.style.backgroundColor='#c4a878';this.style.color='#0d2818';"
                onmouseout="this.style.backgroundColor='';this.style.color='#c4a878';"
              >
                {s.label}
              </a>
            ))}
          </div>
        )}
      </div>

      <div>
        <h3 class="font-semibold mb-5 text-sm uppercase tracking-wider" style="color:#e8d5b0;">Quick Links</h3>
        <ul class="space-y-2.5">
          {[
            { href: '/', label: 'Home' },
            { href: '/about', label: 'About Us' },
            { href: '/activities', label: 'Activities' },
            { href: '/gallery', label: 'Gallery' },
            { href: '/contact', label: 'Contact Us' },
          ].map(l => (
            <li>
              <a href={l.href} class="text-sm transition-colors duration-200" style="color:#a89880;"
                onmouseover="this.style.color='#c4a878';" onmouseout="this.style.color='#a89880';">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="font-semibold mb-5 text-sm uppercase tracking-wider" style="color:#e8d5b0;">Get in Touch</h3>
        <ul class="space-y-3">
          {siteSettings.email && (
            <li>
              <a href={`mailto:${siteSettings.email}`} class="text-sm flex items-center gap-2 transition-colors" style="color:#a89880;"
                onmouseover="this.style.color='#c4a878';" onmouseout="this.style.color='#a89880';">
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                </svg>
                {siteSettings.email}
              </a>
            </li>
          )}
          {siteSettings.phone && (
            <li>
              <a href={`tel:${siteSettings.phone}`} class="text-sm flex items-center gap-2 transition-colors" style="color:#a89880;"
                onmouseover="this.style.color='#c4a878';" onmouseout="this.style.color='#a89880';">
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                </svg>
                {siteSettings.phone}
              </a>
            </li>
          )}
          {siteSettings.address && (
            <li class="text-sm flex items-start gap-2" style="color:#a89880;">
              <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
              </svg>
              {siteSettings.address}
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3" style="border-top:1px solid #1a4a2e;">
      <p class="text-xs" style="color:#6b5a4a;">&copy; {year} ONEA — Nature · Empowerment · Advancement. All rights reserved.</p>
      <p class="text-xs" style="color:#6b5a4a;">Made with ♥ for the Maldives</p>
    </div>
  </div>
</footer>
